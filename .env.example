# =============================================================================
# Inko environment
# =============================================================================
#
# Plan B (hackathon / local demo) — GEMINI ONLY
#   GEMINI_API_KEY  = primary
#   GEMINI_API_KEY2 = backup (used automatically if primary hits quota/rate limits)
#   Leave AssemblyAI + Supabase blank; app uses localStorage demo data.
#
# Plan A (later) — live AssemblyAI voice (+ optional Supabase)
# =============================================================================

# --- Plan B: Gemini only (primary + optional backup key) ---------------------
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_MODEL=gemini-flash-latest
# Home mic replies. Study features keep GEMINI_MODEL.
GEMINI_CHAT_MODEL=gemini-flash-lite-latest

# --- Plan A (optional): AssemblyAI is the voice. Gemini is the brain. --------
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_AGENT_ID=
# Public origin AssemblyAI can call, for example https://inko.example.com
INKO_PUBLIC_URL=
# Shared secret for /api/voice/brain. This is not the Gemini key.
VOICE_BRAIN_SECRET=

# --- Optional: Supabase (hosted auth + persistence) --------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Optional: scheduled AssemblyAI session cleanup --------------------------
CRON_SECRET=
