# Browser-visible Supabase configuration (required for hosted persistence and voice)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase administrative key (secure quiz creation and cleanup cron)
SUPABASE_SECRET_KEY=

# Server-only AssemblyAI Voice Agent configuration
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_AGENT_ID=

# Server-only Gemini generation configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Random 32+ character production secret used by Vercel Cron bearer authentication
CRON_SECRET=
